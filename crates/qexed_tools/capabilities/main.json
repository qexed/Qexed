{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Qexed Tools main window capability.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "allow-plugin-list",
    "allow-plugin-install",
    "allow-plugin-enable",
    "allow-plugin-disable",
    "allow-plugin-remove",
    "allow-install-package",
    "allow-create-package",
    "allow-convert-favicon",
    "allow-apply-favicon",
    "allow-load-code-of-conduct",
    "allow-save-code-of-conduct",
    "allow-generate-config-docs"
  ]
}
